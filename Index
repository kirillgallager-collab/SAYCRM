function openIncome() {
  byId("iSel").innerHTML = '<option value="">Выберите товар</option><option value="__new__">+ Новый товар…</option>' +
    S.db.stock.map(i => '<option value="' + esc(i.name) + '">' + esc(i.name) + (i.av < 0 ? " (не хватает " + fmt(-i.av) + ")" : "") + "</option>").join("");
