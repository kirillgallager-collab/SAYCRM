function isoToRu(iso) { const p = String(iso || "").split("-"); return p.length === 3 ? p[2] + "." + p[1] + "." + p[0] : ""; }
function ruToDate(s) { const p = String(s || "").split("."); return new Date(+p[2], +p[1] - 1, +p[0]); }
function dateKey(d) { return d.getFullYear() + ("0" + (d.getMonth() + 1)).slice(-2) + ("0" + d.getDate()).slice(-2) + "0000"; }
function lsGet(k) { try { return window.localStorage.getItem(k) || ""; } catch (e) { return ""; } }
function lsSet(k, v) { try { if (v) window.localStorage.setItem(k, v); else window.localStorage.removeItem(k); } catch (e) {} }

/** Та же нормализация телефона, что на сервере. */
function normPhone(raw) {
  let s = String(raw || "").trim(); if (!s) return "";
  const plus = s.charAt(0) === "+";
  let d = s.replace(/\D/g, ""); if (!d) return "";
  if (!plus) {
    if (d.indexOf("00") === 0) d = d.slice(2);
    else if (d.length === 11 && d.charAt(0) === "8" && d.charAt(1) === "0") d = "375" + d.slice(2);
    else if (d.length === 11 && d.charAt(0) === "8") d = "7" + d.slice(1);
    else if (d.length === 10 && d.charAt(0) === "9") d = "7" + d;
  }
  return "+" + d;
}
function phoneOk(p) { const n = p.replace(/\D/g, "").length; return n >= 10 && n <= 15; }
function dmOk(s) { if (!s) return true; const m = /^(\d{1,2})[.\/-](\d{1,2})$/.exec(s); return !!m && +m[1] >= 1 && +m[1] <= 31 && +m[2] >= 1 && +m[2] <= 12; }

// ---------- лоадер, окна, уведомления ----------
function showLoader(t) {
  byId("loaderT").textContent = t || "Загрузка…";
  const tips = (S.db.lists && S.db.lists.tips) || [];
  byId("loaderTip").textContent = tips.length ? "💡 " + tips[Math.floor(Math.random() * tips.length)] : "";
  byId("loader").classList.add("on");
}
function hideLoader() { byId("loader").classList.remove("on"); }
let toastTimer = null;
function toast(t) { const el = byId("toast"); el.textContent = t; el.style.display = "block"; clearTimeout(toastTimer); toastTimer = setTimeout(() => { el.style.display = "none"; }, 2600); }

let dlgHandler = null;
/** o: {title, html, ok, cancel (false — без кнопки), danger, onOk(root) → false (не закрывать) | функция (выполнить после закрытия)} */
function dialog(o) {
  byId("dlgT").textContent = o.title || "";
  byId("dlgB").innerHTML = o.html || "";
  byId("dlgE").textContent = "";
  const ok = byId("dlgOk"), no = byId("dlgNo");
  ok.textContent = o.ok || "OK";
  ok.className = o.danger ? "btn-red" : "btn-main";
  no.style.display = o.cancel === false ? "none" : "block";
  no.textContent = o.cancel || "Назад";
  no.onclick = () => { closeDlg(); if (o.onCancel) o.onCancel(); };
  dlgHandler = o.onOk || null;
  byId("dlg").classList.add("on");
}
function dlgConfirm() {
  const fn = dlgHandler;
  let after = null;
  if (fn) { const r = fn(byId("dlgB")); if (r === false) return; if (typeof r === "function") after = r; }
  closeDlg();
  if (after) after();
}
function closeDlg() { byId("dlg").classList.remove("on"); dlgHandler = null; }
function dlgError(t) { byId("dlgE").textContent = t; haptic("error"); }
function showMsg(text, isErr, after) {
  if (isErr) haptic("error");
  dialog({ title: isErr ? "Не получилось" : "Готово", html: '<p style="white-space:pre-wrap;">' + esc(text) + "</p>", ok: "Понятно", cancel: false, onOk: () => after || null });
}
function askConfirm(text, onYes, okText, danger) {
  dialog({ title: "Подтвердите действие", html: '<p style="white-space:pre-wrap;">' + esc(text) + "</p>", ok: okText || "Да", danger: !!danger, onOk: () => onYes });
}

/**
 * R4: единственная дорога к серверу — экран заблокирован, лоадер, оба обработчика.
 * onFail(message) может вернуть true, чтобы не показывать стандартное окно ошибки.
 */
/** Внутри Google — google.script.run; на своём хостинге — запрос на /exec. */
const INSIDE_GAS = typeof google !== "undefined" && google.script && google.script.run;
function srv(fn, args, ok, fail) {
  if (INSIDE_GAS) { const r = google.script.run.withSuccessHandler(ok).withFailureHandler(fail); r[fn].apply(r, args); return; }
  fetch(API_URL, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify({ fn: fn, args: args }) })
    .then(r => r.json())
    .then(r => { if (r && r.ok) ok(r.data); else fail({ message: (r && r.error) || "Сервер не ответил" }); })
    .catch(() => jsonp(fn, args, ok, fail));   // запасной путь, если браузер запретил запрос
}
/** Запасной путь: GET со скриптом-ответом (без ограничений браузера на чужие домены). */
function jsonp(fn, args, ok, fail) {
  const cb = "cb" + Date.now().toString(36) + Math.floor(Math.random() * 1e6);
  const t = setTimeout(() => { delete window[cb]; sc.remove(); fail({ message: "Сервер не ответил" }); }, 60000);
  window[cb] = r => { clearTimeout(t); delete window[cb]; sc.remove(); if (r && r.ok) ok(r.data); else fail({ message: (r && r.error) || "Ошибка" }); };
  const sc = document.createElement("script");
  sc.src = API_URL + "?callback=" + cb + "&fn=" + encodeURIComponent(fn) + "&args=" + encodeURIComponent(JSON.stringify(args));
  sc.onerror = () => { clearTimeout(t); delete window[cb]; sc.remove(); fail({ message: "Нет связи с сервером" }); };
  document.body.appendChild(sc);
}
function call(fn, args, ok, text, onFail) {
  if (S.busy) return;
  S.busy = true;
  showLoader(text);
  srv(fn, args,
    r => { S.busy = false; hideLoader(); try { ok(r); } catch (e) { showMsg("Ошибка интерфейса: " + e.message, true); } },
    err => {
      S.busy = false; hideLoader();
      const m = cleanErr(err && err.message ? err.message : err);
      if (onFail && onFail(m) === true) return;
      if (m.indexOf("SESSION_EXPIRED") > -1) { showLogin(); showMsg(m.replace(/SESSION_EXPIRED:\s*/, "Сессия закончилась: "), true); return; }
      showMsg(m, true);
    });
}

/** Сжатие фото до 1600 px (JPEG 80%). Нераспознанный формат (HEIC) уходит как есть. */
function readPhoto(file, ok, fail) {
  if (file.size > 15 * 1024 * 1024) { fail(); showMsg("Файл больше 15 МБ — выберите фото поменьше.", true); return; }
  const fr = new FileReader();
  fr.onerror = () => { fail(); showMsg("Не удалось прочитать файл.", true); };
  fr.onload = e => {
    const src = e.target.result;
    const img = new Image();
    img.onload = () => {
      try {
        const k = Math.min(1, 1600 / Math.max(img.width, img.height));
        const c = document.createElement("canvas");
        c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
        c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
        ok({ b64: c.toDataURL("image/jpeg", 0.8).split(",")[1], mime: "image/jpeg" });
      } catch (er) { ok({ b64: src.split(",")[1], mime: file.type || "image/jpeg" }); }
    };
    img.onerror = () => ok({ b64: src.split(",")[1], mime: file.type || "image/jpeg" });
    img.src = src;
  };
  fr.readAsDataURL(file);
}
/** Прочитать и сжать фото из поля (если выбрано) — внутри фоновой задачи, без окна загрузки. */
function photoFile(inputId) { const inp = inputId ? byId(inputId) : null; return inp && inp.files && inp.files[0] ? inp.files[0] : null; }
function photoPrep(file, payload, key) {
  return next => { if (!file) { next(); return; } readPhoto(file, ph => { payload[key] = ph; next(); }, () => next()); };
}

// ---------- фоновая очередь: действия уходят на сервер по одному, экран не блокируется ----------
const Q = { jobs: [], busy: false };
/** job: {label, fn, args, ok(r), fail(msg) → true (сам показал), prep(next)} */
function enqueue(job) { Q.jobs.push(job); updQ(); runQ(); }
function runQ() {
  if (Q.busy || !Q.jobs.length) return;
  const j = Q.jobs[0];
  Q.busy = true; updQ();
  const done = () => { Q.jobs.shift(); Q.busy = false; updQ(); runQ(); };
  const exec = () => {
    srv(j.fn, j.args,
      r => { try { if (j.ok) j.ok(r); } catch (e) { showMsg("Ошибка интерфейса: " + e.message, true); } done(); },
      err => {
        const m = cleanErr(err && err.message ? err.message : err);
        if (m.indexOf("SESSION_EXPIRED") > -1) { Q.jobs = []; Q.busy = false; updQ(); showLogin(); showMsg("Сессия закончилась — войдите и повторите: " + j.label, true); return; }
        if (!(j.fail && j.fail(m) === true)) showMsg(j.label + ": " + m, true);
        done();
      });
  };
  if (j.prep) j.prep(exec); else exec();
}
function updQ() {
  const el = byId("qBar"), n = Q.jobs.length;
  el.style.display = n ? "flex" : "none";
  if (n) el.innerHTML = '<span class="qspin"></span>' + esc(Q.jobs[0].label) + (n > 1 ? " · ещё " + (n - 1) : "");
}
window.addEventListener("beforeunload", e => { if (Q.jobs.length) { e.preventDefault(); e.returnValue = ""; } });
/** Если открыта карточка этого заказа — перерисовать её свежими данными. */
function refreshCard(id) { if (byId("cardM").classList.contains("on") && S.cardId === id) openCard(id); }

// ---------- вход / выход ----------
byId("verLbl").textContent = "SAYCRM " + APP_VERSION;
function diagText() {
  let top = "нет"; try { top = window.self !== window.top ? "да" : "нет"; } catch (e) { top = "да"; }
  let ls = "нет"; try { window.localStorage.setItem("t", "1"); window.localStorage.removeItem("t"); ls = "да"; } catch (e) {}
  return ["Версия: " + APP_VERSION, "Telegram.WebApp: " + (tg ? "есть" : "нет"), "Платформа: " + (tg ? (tg.platform || "—") : "—"),
    "initData: " + (tg ? (tg.initData || "").length : 0) + " симв.", "Внутри фрейма: " + top,
    "Запоминание входа доступно: " + ls, "Экран: " + window.innerWidth + "×" + window.innerHeight].join("\n");
}
let verTaps = 0, verTimer = null;
/** Диагностика скрыта от сотрудников: три касания по надписи с версией. */
function tapVer() {
