  if (TERMINAL.indexOf(s) < 0 && can("cancel")) h += btnH("Отменить заказ", "askCancel('" + o.id + "','" + ST.CANCELED + "')", "btn-red");

  h += btnGroup([btnH("Печать чека", "printReceipt('" + o.id + "')", "btn-main"), btnH("Карточка сборки", "printAssembly('" + o.id + "')", "btn-main")]);
  if (o.phone) h += btnGroup([btnH("Написать клиенту", "writeClient('" + o.id + "')", "btn-out")]);
  h += '<hr class="hr"><h3>Комментарии</h3>' + (o.comments ? '<div class="pre">' + esc(o.comments) + "</div>" : '<p class="muted">Пока нет.</p>') +
    '<textarea id="cmTxt" rows="2" placeholder="Новый комментарий"></textarea>' + btnH("Добавить комментарий", "addComment('" + o.id + "')", "btn-out");

  S.cardId = o.id;
  byId("cdTitle").textContent = "Заказ #" + o.id;
  byId("cdBody").innerHTML = gridBtns(h);
  openModal("cardM");
}
/** keepOpen — после действия показать карточку заново (флорист взял заказ и смотрит состав). */
/** Смена статуса — в фоне. keepOpen: карточка не закрывается и обновится, когда сервер ответит. */
function doStatus(id, to, extra, photoInput, keepOpen) {
  extra = extra || {};
  const key = id + "→" + to;
  if (Q.jobs.some(j => j.key === key)) { toast("Уже отправлено, ждём сервер"); return; }
  const file = photoFile(photoInput);
  if (!keepOpen) closeModal("cardM");
  toast("Заказ #" + id + ": " + to + " — отправлено");
  enqueue({ key: key, label: "Заказ #" + id + " → " + to, fn: "updateOrderStatus", args: [S.token, id, to, extra], prep: photoPrep(file, extra, "photo"),
    ok: r => { haptic("success"); toast(r.msg); applyData(r, () => refreshCard(id)); } });
}
function confirmDone(id) {
  const inp = byId("aPhoto");
  if (S.db.cfg.photoRequired && !(inp && inp.files && inp.files[0])) { showMsg("Приложите фото сборки — так задано в настройках.", true); return; }
  askConfirm("Отметить заказ собранным? Товар спишется со склада.", () => doStatus(id, ST.DONE, {}, "aPhoto"), "Собран");
}
/** Выдача: без долга — подтверждение; с долгом — окно оплаты на всю сумму (в долг не выдаём). */
function closeOrder(id, to, photoInput) {
  const o = findOrder(id); if (!o) return;
  const debt = debtOf(o);
  if (debt <= 0) { askConfirm("Заказ #" + id + ": отметить «" + to + "»? Заказ будет закрыт.", () => doStatus(id, to, {}, photoInput), "Подтвердить"); return; }
  if (!can("pay")) { showMsg("По заказу долг " + money(debt) + ". У вас нет права принимать оплату — позовите сотрудника, который может.", true); return; }
  payDialog(o, true, pays => doStatus(id, to, { payments: pays }, photoInput));
}
/** Окно оплаты. exact — нужно ровно на сумму долга (выдача); иначе от 0 до долга. */
function payDialog(o, exact, onPay) {
  const debt = debtOf(o);
  S.payNeed = debt;
  dialog({ title: (exact ? "Оплата при выдаче #" : "Принять оплату #") + o.id,
    html: '<div class="pay-big">' + (exact ? "Взять с клиента: " : "Долг: ") + money(debt) + "</div>" +
      '<div id="payRows"></div><button class="btn-out" onclick="addPayRow()">+ ещё способ</button><p id="payInfo" class="muted small"></p>',
    ok: exact ? "Оплачено, выдать" : "Принять", onOk: root => {
      const rows = Array.prototype.slice.call(root.querySelectorAll(".payrow"));
      const pays = rows.map(r => ({ method: r.querySelector("select").value, sum: num(r.querySelector("input").value) })).filter(p => p.sum > 0 || p.method);
      if (!pays.length) { dlgError("Укажите сумму и способ."); return false; }
      if (pays.some(p => !p.method)) { dlgError("Выберите способ для каждой суммы."); return false; }
