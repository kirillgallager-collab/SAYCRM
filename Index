// ---------- карточка заказа ----------
function kv(k, v) { return (v === "" || v == null) ? "" : '<div class="kv"><span>' + esc(k) + "</span><b>" + v + "</b></div>"; }
function btnH(text, js, cls) { return '<button class="' + (cls || "btn-soft") + '" onclick="' + js + '">' + esc(text) + "</button>"; }
/** Группа кнопок: 1 — на всю строку, 2 — в строку, 3 — 2 + 1 на всю строку (и так далее). */
function btnGroup(list) { const b = list.filter(x => x); return b.length ? '<div class="btns">' + b.join("") + "</div>" : ""; }
/** Подряд идущие кнопки в разметке собрать в сетку по 2. */
function gridBtns(html) {
  // уже собранные группы (<div class="btns">…) не трогаем: иначе сетка вкладывается в сетку и кнопки сужаются
  return html.split(/(<div class="btns">[\s\S]*?<\/div>)/).map(part => part.indexOf('<div class="btns">') === 0 ? part
    : part.replace(/(?:<button class="[^"]*" onclick="[^"]*">[^<]*<\/button>){2,}/g, m => '<div class="btns">' + m + "</div>")).join("");
}
function openCard(id) {
  const o = findOrder(id); if (!o) return;
  const s = o.status, me = S.user;
  const arrow = o.fact > o.plan ? " ⬆" : (o.fact < o.plan ? " ⬇" : "");
  const nl = t => esc(t).replace(/\n/g, "<br>");
  const debt = debtOf(o);
  const issuer = can("issue");
  const pickup = o.dlvType === "Самовывоз";
  let h = '<p style="text-align:center;"><span class="' + stClass(s) + '">' + esc(s) + "</span></p>";
  if (debt > 0) h += '<div class="pay-big">Взять с клиента: ' + money(debt) + "</div>";
  const short = orderShortage(o);
  if (short.length) h += '<div class="warn">⚠ Заказ под поставку. Сейчас на складе не хватает: ' + short.map(x => esc(x.name) + " (есть " + fmt(x.have) + ", нужно " + fmt(x.need) + ")").join(", ") + ". «Собран» — после прихода.</div>";
  h += kv("Выдача", esc(o.date)) + kv("Клиент", esc(o.client) + (o.phone ? "<br>" + esc(o.phone) : "")) +
    kv("Получатель", nl(o.recipient)) + kv("Адрес", nl(o.addr)) + kv("Состав", nl(o.desc)) +
    kv("По РРЦ", money(o.plan)) + kv("Цена продажи", money(o.fact) + arrow) + kv("Оплачено", money(o.paid)) + (o.bonusUsed ? kv("Оплачено бонусами", money(o.bonusUsed)) : "") + (o.bonusAdd ? kv("Начислено бонусов", fmt(o.bonusAdd)) : "") +
    kv("Оплаты", (o.pays || []).map(p => esc(p.method) + " " + money(p.sum) + ' <span class="muted small">' + esc(p.by || "") + " " + esc(p.at || "") + "</span>").join("<br>")) + kv("Источник", esc(o.source)) + kv("Скидка", esc(o.discount)) +
    kv("Получение", esc(o.dlvType)) + (o.courier ? kv("Курьер", esc(o.courier) + (o.courierCt ? "<br>" + esc(o.courierCt) : "")) : "") +
    (o.dlvCost ? kv("Доставка", money(o.dlvCost)) : "") + kv("Создал", esc(o.creator)) +
    (o.assembler !== "-" ? kv("Собирает / собрал", esc(o.assembler)) : "") + (o.logist !== "-" ? kv("Выдал", esc(o.logist)) : "") +
    kv("Создан", esc(o.created)) + kv("Взят в сборку", esc(o.tTaken)) + kv("Собран", esc(o.tDone)) + kv("Выдан", esc(o.tOut)) +
    (o.costFact ? kv("Себестоимость", money(o.costFact)) + kv("Маржа", money(o.margin)) : "") +
    kv("Причина", esc(o.reason)) + kv("Судьба товара", esc(o.fate));
  h += '<div style="height:12px;"></div>';
  [["Открыть фото-пример", o.photoEx], ["Открыть фото сборки", o.photoAs], ["Открыть фото вручения", o.photoDl]].forEach(p => {
    if (/^https?:\/\//.test(p[1])) h += '<a class="ph" href="' + esc(p[1]) + '" target="_blank" rel="noopener">' + p[0] + "</a>";
  });

  // действия (сервер проверяет всё ещё раз)
  if (debt > 0 && can("pay")) h += btnH("Принять оплату", "payOrder('" + o.id + "')", "btn-main");
  if (o.overpay > 0 && o.paid > 0 && TERMINAL.indexOf(s) < 0) {
    h += '<div class="warn">Переплата клиента: ' + money(o.overpay) + " (цену уменьшили).</div>";
    if (can("pay")) h += btnH("Вернуть переплату", "refundOver('" + o.id + "')", "btn-out");
  }
  if ((s === ST.WAIT && (can("order") || can("build"))) || (s === ST.WORK && can("build") && (me.role === R.ADMIN || o.assembler === me.name)))
    h += btnH("Изменить состав", "openEdit('" + o.id + "')", "btn-soft");
  if (s === ST.WAIT && can("build")) h += btnH("Взять в сборку", "doStatus('" + o.id + "','" + ST.WORK + "',{},null,true)", "btn-main");
  if (s === ST.WORK) {
    if (can("build") && (me.role === R.ADMIN || o.assembler === me.name)) {
      h += '<label class="lbl">Фото сборки ' + (S.db.cfg.photoRequired ? "(обязательно)" : "(по желанию)") + '</label><input type="file" id="aPhoto" accept="image/*">' +
        btnH("Собран", "confirmDone('" + o.id + "')", "btn-main") + btnH("Вернуть в общий пул", "doStatus('" + o.id + "','" + ST.WAIT + "')", "btn-out");
    } else h += '<p class="muted">Заказ собирает ' + esc(o.assembler) + ".</p>";
  }
  if (s === ST.DONE && issuer && pickup) h += btnH("Выдан самовывозом", "closeOrder('" + o.id + "','" + ST.PICKED + "')", "btn-main");
