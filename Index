// ---------- написать клиенту ----------
function msgText(o, key) {
  const t = (S.db.msgTpl || {})[key] || "";
  return t.replace(/\{клиент\}/g, o.client || "").replace(/\{номер\}/g, o.id || "").replace(/\{дата\}/g, o.date || "")
    .replace(/\{сумма\}/g, money(o.fact || 0)).replace(/\{долг\}/g, money(o.debt || 0))
    .replace(/\{бонусы\}/g, fmt(o.bonus || 0)).replace(/\{магазин\}/g, S.db.cfg.shop || "");
}
function writeClient(id) {
  const o = findOrder(id); if (!o || !o.phone) return;
  msgDialog(o, o.status);
}
/** Сообщение клиенту из карточки клиента: баланс бонусов, памятная дата. */
function writeClientBonus() {
  const c = S.cl; if (!c || !c.phone) return;
  msgDialog({ client: c.name, phone: c.phone, bonus: c.bonus, id: "", date: c.last, fact: c.total, debt: 0 }, "Бонусы");
}
function msgDialog(o, prefer) {
  const keys = Object.keys(S.db.msgTpl || {});
  const def = keys.indexOf(prefer) > -1 ? prefer : (keys[0] || "");
  S.msgCtx = o;
  dialog({ title: "Написать клиенту", ok: "Открыть", html: '<p class="muted small">' + esc(o.client) + " · " + esc(o.phone) + "</p>" +
    '<label class="lbl">Мессенджер</label><select id="wcM"><option value="wa">WhatsApp</option><option value="tg">Telegram</option><option value="max">MAX</option></select>' +
    '<label class="lbl">Шаблон</label><select id="wcT" onchange="wcFill()">' + keys.map(k => '<option value="' + esc(k) + '"' + (k === def ? " selected" : "") + ">" + esc(k) + "</option>").join("") + "</select>" +
    '<textarea id="wcTxt" rows="4">' + esc(msgText(o, def)) + "</textarea>" +
    '<p class="muted small">Текст шаблонов меняется в «Админ» → «Шаблоны сообщений».</p>',
    onOk: root => {
      const m = root.querySelector("#wcM").value, txt = root.querySelector("#wcTxt").value.trim();
      const digits = o.phone.replace(/\D/g, "");
      return () => {
        if (m === "wa") window.open("https://wa.me/" + digits + "?text=" + encodeURIComponent(txt), "_blank");
        else if (m === "tg") window.open("https://t.me/share/url?url=&text=" + encodeURIComponent(txt), "_blank");
        else { copyText(txt); window.open("https://max.ru/", "_blank"); toast("Текст скопирован — вставьте в чат MAX"); }
      };
    } });
}
function wcFill() { if (S.msgCtx) byId("wcTxt").value = msgText(S.msgCtx, byId("wcT").value); }
function copyText(t) {
  try { if (navigator.clipboard) { navigator.clipboard.writeText(t); return; } } catch (e) {}
  const ta = document.createElement("textarea"); ta.value = t; document.body.appendChild(ta); ta.select();
  try { document.execCommand("copy"); } catch (e) {}
  ta.remove();
}

