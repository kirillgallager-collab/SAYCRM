<script>
const APP_VERSION = "v1.0 · 22.09.2026";
/** Ссылка развёртывания Apps Script (…/exec). Пусто — приложение работает внутри Google как раньше. */
const API_URL = "";
const R = { ADMIN: "Администратор", MANAGER: "Менеджер", FLORIST: "Флорист", LOGIST: "Логист" };
const ST = { WAIT: "Ожидает сборки", WORK: "В процессе сборки", DONE: "Собран", PICKUP_WAIT: "Ожидает самовывоза",
  COURIER: "У курьера", PICKED: "Выдан самовывозом", RECEIVED: "Получен покупателем", REFUSED: "Отказ", CANCELED: "Отменен" };
const TERMINAL = [ST.PICKED, ST.RECEIVED, ST.REFUSED, ST.CANCELED];
const AFTER_ASSEMBLY = [ST.DONE, ST.PICKUP_WAIT, ST.COURIER];
const FATE_RETURN = "Вернуть на склад", FATE_UTIL = "Списать (утилизация)";
const TOKEN_KEY = "saycrm_token";
const VIT = "Витрина";

const tg = (window.Telegram && window.Telegram.WebApp) ? window.Telegram.WebApp : null;
try { if (tg) { tg.ready(); tg.expand(); } } catch (e) {}

const S = { token: "", user: null, db: { stock: [], orders: [], lists: {}, cfg: {} }, filter: "all", date: "", q: "",
  cart: [], factTouched: false, reqOrder: null, inc: [], reqInc: null, reqWoff: null, busy: false, found: [] };

// ---------- утилиты ----------
const byId = id => document.getElementById(id);
function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])); }
function num(v) { const n = parseFloat(String(v == null ? "" : v).replace(/\s/g, "").replace(",", ".")); return isFinite(n) ? n : 0; }
function fmt(v) { return (Math.round(num(v) * 100) / 100).toLocaleString("ru-RU"); }
function money(v) { return fmt(v) + " " + (S.db.cfg.currency || "₽"); }
function uuid() { return "r" + Date.now().toString(36) + Math.random().toString(36).slice(2, 10); }
function cleanErr(m) { return String(m || "Неизвестная ошибка").replace(/^(Error|Exception|Ошибка):\s*/i, ""); }
/** Есть ли у сотрудника галочка (сервер всё равно проверит). */
function can(cap) { return !!(S.user && S.user.caps && S.user.caps[cap]); }
