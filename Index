/** Печатает переданный HTML: скрытая рамка, обычный принтер. */
function printHtml(title, body) {
  const css = "body{font-family:Arial,sans-serif;color:#000;margin:0;padding:14px;font-size:13px}" +
    "h1{font-size:17px;margin:0 0 4px}h2{font-size:14px;margin:12px 0 4px}table{width:100%;border-collapse:collapse}" +
    "td,th{padding:4px 2px;border-bottom:1px solid #ddd;text-align:left;font-size:12px}td.r,th.r{text-align:right}" +
    ".mut{color:#666;font-size:11px}.tot{font-size:15px;font-weight:700;margin-top:8px}" +
    ".tag{display:inline-block;width:32%;border:1px solid #bbb;border-radius:6px;margin:0 1% 8px 0;padding:8px;text-align:center;box-sizing:border-box}" +
    ".tag b{display:block;font-size:13px;margin-bottom:4px}.tag span{font-size:18px;font-weight:700}";
  const html = "<html><head><meta charset='utf-8'><title>" + esc(title) + "</title><style>" + css + "</style></head><body>" + body + "</body></html>";
  const f = document.createElement("iframe");
  f.style.cssText = "position:fixed;right:0;bottom:0;width:0;height:0;border:0";
  document.body.appendChild(f);
  const d = f.contentWindow.document;
  d.open(); d.write(html); d.close();
  setTimeout(() => {
    try { f.contentWindow.focus(); f.contentWindow.print(); }
    catch (e) { byId("printArea").innerHTML = html; window.print(); }   // запасной путь
    setTimeout(() => { f.remove(); byId("printArea").innerHTML = ""; }, 1000);
  }, 250);
}
