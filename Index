}
applyTheme();

function login() {
  const pin = byId("pin").value.trim();
  if (!pin) { showMsg("Введите ПИН-код.", true); return; }
  let dev = lsGet("saycrm_dev"); if (!dev) { dev = uuid(); lsSet("saycrm_dev", dev); }
  call("authUser", [pin, dev], r => {
    S.token = r.token; S.user = { name: r.name, role: r.role, caps: r.caps || {} };
    lsSet(TOKEN_KEY, r.token);
    byId("pin").value = "";
    if (r.version !== APP_VERSION) toast("Сервер " + r.version + ", экран " + APP_VERSION + " — выпустите новую версию развёртывания");
    haptic("success");
    enterApp();
    loadDb();
  }, "Проверяем ПИН…");
}
/** Показать экран входа без перезагрузки страницы (перезагрузка внутри Google даёт белый экран). */
function showLogin() {
  lsSet(TOKEN_KEY, "");
