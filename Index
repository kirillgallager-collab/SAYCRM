function openModal(id) { byId(id).classList.add("on"); byId(id).scrollTop = 0; }
function closeModal(id) { byId(id).classList.remove("on"); }

// ---------- данные ----------
function loadDb(after) {
  call("getInitialData", [S.token], d => {
    S.db = d; S.user = d.user;
    renderAll();
    if (after) after();
  }, "Загружаем данные…");
}
/** Свежие данные пришли в ответе действия — показываем без второго запроса. */
function applyData(r, after) {
  if (r && r.data) { S.db = r.data; S.user = r.data.user; renderAll(); if (after) after(); }
  else loadDb(after);
}
function renderAll() {
  applyCaps();
  renderOrders(); renderStock(); renderLog(); renderVit(); renderPrices();
  if (byId("cashM").classList.contains("on")) renderCash();
  if (byId("dayM").classList.contains("on")) renderDay();
  // отчёт не перезапрашиваем при обновлении данных: он считается на сервере по кнопкам периода
}
function sumBy(list, key, val) { const m = {}; list.forEach(x => { m[x[key]] = (m[x[key]] || 0) + val(x); }); return m; }
function payLines(pays) {
  const m = sumBy(pays, "method", p => p.sum), keys = Object.keys(m);
  return keys.length ? keys.map(k => kv(k, money(m[k]))).join("") + kv("Всего", "<b>" + money(pays.reduce((a, p) => a + p.sum, 0)) + "</b>") : '<p class="muted small">Оплат нет.</p>';
}
/** Дата «ДД.ММ.ГГГГ» ↔ значение поля даты. */
function ruToIso(ru) { const p = String(ru || "").split("."); return p.length === 3 ? p[2] + "-" + p[1] + "-" + p[0] : ""; }
function dk(ru) { const p = String(ru || "").slice(0, 10).split("."); return p.length === 3 ? p[2] + p[1] + p[0] : ""; }
/** Итоги сотрудника за день: создал, собрал, выдал, принял денег по способам. */
function staffStats(name, from, to) {
  const inR = d => { const k = dk(d); return k && k >= from && k <= to; };
  const lost = o => o.status === ST.CANCELED || o.status === ST.REFUSED;
  const O = S.db.orders;
  const made = O.filter(o => o.creator === name && inR(o.created) && !lost(o));
  return { made: made, built: O.filter(o => o.assembler === name && inR(o.tDone)), given: O.filter(o => o.logist === name && inR(o.tOut)),
    pays: (S.db.payments || []).filter(p => p.user === name && inR(p.time)) };
}
function openDay() {
  byId("dayDate").value = ruToIso(S.db.cfg.today);
  renderDay(); openModal("dayM");
}
function renderDay() {
  const day = dk(isoToRu(byId("dayDate").value)) || dk(S.db.cfg.today);
  const st = staffStats(S.user.name, day, day);
  byId("dayBox").innerHTML = '<div class="card"><h3>' + esc(S.user.name) + "</h3>" +
    kv("Создал заказов", st.made.length + " на " + money(st.made.reduce((a, o) => a + o.fact, 0))) + kv("Собрал", String(st.built.length)) + kv("Выдал", String(st.given.length)) +
    "</div>" + '<div class="card"><h3>Принял денег</h3>' + payLines(st.pays) + "</div>";
}
function findOrder(id) { return S.db.orders.find(o => o.id === id); }
function stClass(s) { return TERMINAL.indexOf(s) > -1 ? "status off" : (AFTER_ASSEMBLY.indexOf(s) > -1 ? "status done" : "status"); }
function stockOf(name) { return S.db.stock.find(i => i.name === name); }
/** Чего физически не хватает, чтобы собрать заказ прямо сейчас. */
function orderShortage(o) {
  if (o.status !== ST.WAIT && o.status !== ST.WORK) return [];
  return o.items.map(it => { const s = stockOf(it.name); return s && s.phys < it.qty ? { name: it.name, have: s.phys, need: it.qty } : null; }).filter(x => x);
}

// ---------- заказы ----------
function setFilter(t) {
  S.filter = t; S.date = "";
  ["fAll", "fToday", "fTom"].forEach(id => byId(id).classList.remove("on"));
  byId({ all: "fAll", today: "fToday", tomorrow: "fTom" }[t]).classList.add("on");
  byId("dp").value = ""; byId("dp").classList.remove("on");
  S.archFound = []; S.archKey = "";
  renderOrders();
}
function onPickDate(v) {
  if (!v) { setFilter("all"); return; }
  S.filter = "date"; S.date = isoToRu(v);
  ["fAll", "fToday", "fTom"].forEach(id => byId(id).classList.remove("on"));
  byId("dp").classList.add("on");
  renderOrders(); findEverywhere();
}
function orderList() {
  const cfg = S.db.cfg, u = S.user;
  let list = S.db.orders.slice();
  if (u.role !== R.ADMIN && can("build")) list = list.filter(o => !(o.status === ST.WORK && o.assembler !== "-" && o.assembler !== u.name));
  if (S.filter === "today") list = list.filter(o => o.date.slice(0, 10) === cfg.today);
  else if (S.filter === "tomorrow") list = list.filter(o => o.date.slice(0, 10) === cfg.tomorrow);
  else if (S.filter === "date" && S.date) list = list.filter(o => o.date.slice(0, 10) === S.date);
  const q = (S.q || "").trim().toLowerCase(), qd = q.replace(/\D/g, "");
  if (q) list = list.filter(o => o.id.toLowerCase().indexOf(q) > -1 || o.client.toLowerCase().indexOf(q) > -1 ||
    o.recipient.toLowerCase().indexOf(q) > -1 || (qd.length >= 3 && o.phone.replace(/\D/g, "").indexOf(qd) > -1));
  const act = o => TERMINAL.indexOf(o.status) < 0;
  list.sort((a, b) => {
    const x = act(a), y = act(b);
    if (x !== y) return x ? -1 : 1;
    return x ? a.dKey.localeCompare(b.dKey) : b.dKey.localeCompare(a.dKey);
  });
  return list;
}
function debtOf(o) { return (o.status === ST.CANCELED || o.status === ST.REFUSED) ? 0 : num(o.debt); }
function orderCard(o) {
  const closed = TERMINAL.indexOf(o.status) > -1;
  const hot = !closed && o.date.slice(0, 10) === S.db.cfg.today;
  const debt = debtOf(o);
  const who = o.status === ST.WORK && o.assembler !== "-" ? '<div class="muted small">Собирает: ' + esc(o.assembler) + "</div>" : "";
  const short = orderShortage(o).length ? '<div class="small" style="color:#8a5a00;margin-top:4px;">⚠ ждёт поставки</div>' : "";
  return '<div class="card tap' + (hot ? " hot" : "") + (closed ? " closed" : "") + '" onclick="openCard(\'' + esc(o.id) + '\')">' +
    '<div class="between" style="margin-bottom:6px;"><b>#' + esc(o.id) + '</b><span class="' + stClass(o.status) + '">' + esc(o.status) + "</span></div>" +
    '<div class="between"><span>' + esc(o.client) + "</span><b>" + money(o.fact) + "</b></div>" +
    '<div class="between" style="margin-top:4px;"><span class="muted small">' + esc(o.date) + "</span>" + (debt > 0 ? '<span class="pay">к доплате ' + money(debt) + "</span>" : "") + "</div>" +
    who + short + "</div>";
}
function renderOrders() {
  if (!S.user) return;
  const l = orderList();
  const arch = (S.archFound || []).filter(o => !l.some(x => x.id === o.id));
  byId("listO").innerHTML = (l.length ? l.map(orderCard).join("") : "") +
    (arch.length ? '<p class="muted small" style="margin:10px 0 4px;">Из архива (' + arch.length + "):</p>" + arch.map((o, i) => '<div class="card tap closed" onclick="openArch(' + i + ')"><div class="between"><b>#' + esc(o.id) +
      '</b><span class="status off">' + esc(o.status) + '</span></div><div class="between"><span>' + esc(o.client) + "</span><b>" + money(o.fact) + '</b></div><div class="muted small">' + esc(o.date) + " · архив</div></div>").join("") : "") +
    (!l.length && !arch.length ? '<p class="muted" style="text-align:center;">Заказов нет. Проверьте фильтр или создайте новый.</p>' : "");
  S.arch = arch;
}
function renderLog() {
  if (!S.user) return;
  const l = S.db.orders.filter(o => AFTER_ASSEMBLY.indexOf(o.status) > -1).sort((a, b) => a.dKey.localeCompare(b.dKey));
  byId("listL").innerHTML = l.length ? l.map(orderCard).join("") : '<p class="muted" style="text-align:center;">Собранных заказов нет.</p>';
