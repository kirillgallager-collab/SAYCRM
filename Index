  onIncSel(); renderInc(); openModal("incM");
}
function onIncSel() { byId("iNewBox").style.display = byId("iSel").value === "__new__" ? "block" : "none"; incHint(); }
function incHint() {
  const q = num(byId("iQty").value), p = num(byId("iPrice").value);
  byId("iHint").textContent = p > 0 ? "Сумма строки: " + money(q * p) + " · РРЦ по коэффициенту ≈ " + money(p * num(S.db.cfg.coef)) + " (после пересчёта средней себестоимости может отличаться)" : "";
}
function addIncLine() {
  const v = byId("iSel").value, isNew = v === "__new__";
  const name = isNew ? byId("iNewName").value.trim().replace(/\s+/g, " ") : v;
  const qRaw = byId("iQty").value, pRaw = byId("iPrice").value;
  const cat = isNew ? byId("iNewCat").value : "", own = isNew ? num(byId("iNewOwn").value) : 0;
  if (!name) { showMsg(isNew ? "Введите название нового товара." : "Выберите товар.", true); return; }
  if (isNew && S.db.stock.some(i => i.name.toLowerCase() === name.toLowerCase())) { showMsg("«" + name + "» уже есть в списке — выберите его, а не создавайте заново.", true); return; }
  if (isNew && !cat) { showMsg("Выберите категорию нового товара.", true); return; }
  if (S.inc.some(l => l.name.toLowerCase() === name.toLowerCase())) { showMsg("«" + name + "» уже в накладной — поправьте количество в строке.", true); return; }
  S.inc.push({ name: name, isNew: isNew, cat: cat, qty: qRaw === "" ? "" : num(qRaw), price: pRaw === "" ? "" : num(pRaw), own: own });
  ["iQty", "iPrice", "iNewName", "iNewOwn"].forEach(id => { byId(id).value = ""; });
  byId("iSel").value = ""; onIncSel(); renderInc();
}
function removeInc(i) { S.inc.splice(i, 1); renderInc(); }
function renderInc() {
  byId("incL").innerHTML = S.inc.map((l, i) => '<div class="card" style="padding:10px;"><div class="between"><b>' + esc(l.name) + (l.isNew ? ' <span class="muted small">(новый)</span>' : "") +
    '</b><button class="x" onclick="removeInc(' + i + ')" aria-label="Убрать">✕</button></div><div class="row">' +
    '<input type="number" inputmode="decimal" placeholder="Кол-во" style="margin:6px 0 0;" value="' + (l.qty === "" ? "" : l.qty) + '" oninput="incSet(' + i + ',\'qty\',this.value)">' +
    '<input type="number" inputmode="decimal" placeholder="Цена за шт." style="margin:6px 0 0;" value="' + (l.price === "" ? "" : l.price) + '" oninput="incSet(' + i + ',\'price\',this.value)"></div></div>').join("");
  incTotal();
}
function incSet(i, k, v) { S.inc[i][k] = v === "" ? "" : num(v); incTotal(); }
function incTotal() { byId("iTot").textContent = money(S.inc.reduce((s, l) => s + num(l.qty) * num(l.price), 0)); }
function submitIncome() {
  if (!S.inc.length) { showMsg("Добавьте хотя бы одну строку накладной.", true); return; }
  const bad = S.inc.filter(l => !(num(l.qty) > 0) || l.price === "" || num(l.price) < 0);
  if (bad.length) { showMsg("Впишите количество и цену: " + bad.map(l => l.name).join(", ") + ".", true); return; }
  const total = S.inc.reduce((s, l) => s + num(l.qty) * num(l.price), 0);
  askConfirm("Провести приход: " + S.inc.length + " поз. на сумму " + money(total) + "?", () => {
    const lines = S.inc.slice(), inv = byId("iInv").value.trim(), rq = uuid();
    S.inc = []; byId("iInv").value = ""; renderInc(); closeModal("incM");
    enqueue({ label: "Приход (" + lines.length + " поз.)", fn: "processStock", args: [S.token, { type: "Приход", requestId: rq, invoice: inv, lines: lines }],
      ok: r => { toast(r.msg); applyData(r); },
      fail: m => {
        dialog({ title: "Приход не проведён", html: '<p style="white-space:pre-wrap;">' + esc(m) + "</p>", ok: "Открыть накладную", cancel: "Закрыть",
          onOk: () => () => { S.inc = lines; openIncome(); byId("iInv").value = inv; } });
        return true;
      } });
  }, "Провести");
}

// ---------- списание ----------
function openWoff() {
  byId("wSel").innerHTML = '<option value="">Выберите товар</option>' + S.db.stock.filter(i => i.av > 0).map(i =>
    '<option value="' + esc(i.name) + '">' + esc(i.name) + " (свободно " + fmt(i.av) + ")</option>").join("");
  openModal("woffM");
}
function submitWoff() {
  const name = byId("wSel").value, qty = num(byId("wQty").value), reason = byId("wReason").value.trim();
  if (!name) { showMsg("Выберите товар.", true); return; }
  if (qty <= 0) { showMsg("Укажите количество больше нуля.", true); return; }
  if (!reason) { showMsg("Укажите причину списания.", true); return; }
  const item = stockOf(name);
  if (item && qty > item.av) { showMsg("Свободно только " + fmt(Math.max(0, item.av)) + ". Товар в резерве списать нельзя — он под заказы.", true); return; }
  askConfirm("Списать «" + name + "» × " + fmt(qty) + "? Это нельзя отменить.", () => {
    const file = photoFile("wPhoto"), d = { type: "Списание", requestId: uuid(), name: name, qty: qty, reason: reason };
    ["wQty", "wReason", "wPhoto"].forEach(id => { byId(id).value = ""; }); closeModal("woffM");
    enqueue({ label: "Списание «" + name + "»", fn: "processStock", args: [S.token, d], prep: photoPrep(file, d, "photo"), ok: r => { toast(r.msg); applyData(r); } });
  }, "Списать", true);
}

// ---------- касса (наличные, галочка «Касса») ----------
function openCash() { S.cashDays = S.cashDays || 0; renderCash(); openModal("cashM"); }
function cashPeriod(days, el) {
  S.cashDays = days;
  Array.prototype.forEach.call(byId("cashChips").children, c => c.classList.remove("on"));
  el.classList.add("on");
  renderCash();
}
function renderCash() {
  const c = S.db.cash;
  if (!c) { byId("cashTop").innerHTML = '<p class="muted">Нет доступа к кассе.</p>'; byId("cashList").innerHTML = ""; return; }
  const d = ruToDate(S.db.cfg.today), to = new Date(d), from = new Date(d), days = S.cashDays || 0;
  if (days === 1) { to.setDate(to.getDate() - 1); from.setDate(from.getDate() - 1); } else if (days > 1) from.setDate(from.getDate() - (days - 1));
  const k = x => x.getFullYear() + ("0" + (x.getMonth() + 1)).slice(-2) + ("0" + x.getDate()).slice(-2);
  const f = k(from), t = k(to);
  const rows = c.rows.filter(r => { const x = dk(r.time); return x >= f && x <= t; });
  const inc = rows.filter(r => r.sum > 0).reduce((a, r) => a + r.sum, 0), out = rows.filter(r => r.sum < 0).reduce((a, r) => a + r.sum, 0);
  byId("cashTop").innerHTML = '<div class="card" style="text-align:center;"><div class="muted small">Сейчас в кассе (' + esc(c.method) + ')</div>' +
    '<div style="font-size:30px;font-weight:600;color:var(--ink);margin:4px 0;">' + money(c.balance) + "</div></div>";
  byId("cashList").innerHTML = '<div class="card">' + kv("Приход за период", money(inc)) + kv("Расход за период", money(-out)) + "</div>" +
    (rows.length ? '<div class="card"><table class="tbl"><tr><th>Время</th><th>Операция</th><th class="r">Сумма</th><th class="r">Остаток</th></tr>' +
      rows.slice().reverse().map(r => "<tr><td>" + esc(r.time) + '<br><span class="muted small">' + esc(r.user) + "</span></td><td>" + esc(r.reason ? r.op + ": " + r.reason : r.op) + (r.order ? " #" + esc(r.order) : "") +
        (r.note ? '<br><span class="muted small">' + esc(r.note) + "</span>" : "") + '</td><td class="r" style="color:' + (r.sum < 0 ? "var(--red)" : "var(--ok)") + ';">' +
        (r.sum > 0 ? "+" : "") + money(r.sum) + '</td><td class="r">' + money(r.bal) + "</td></tr>").join("") + "</table></div>"
      : '<p class="muted">За период движений нет.</p>');
}
function cashOp(op) {
  const out = op === "Изъятие";
  const reasons = (out ? S.db.lists.cashOut : S.db.lists.cashIn) || [];
  dialog({ title: out ? "Изъять из кассы" : "Внести в кассу",
    html: '<p class="muted small">В кассе сейчас: ' + money(S.db.cash ? S.db.cash.balance : 0) + "</p>" +
      '<select id="cxReason"><option value="">Причина</option>' + reasons.map(r => '<option value="' + esc(r) + '">' + esc(r) + "</option>").join("") + "</select>" +
      '<input type="number" id="cxSum" inputmode="decimal" placeholder="Сумма">' +
      '<textarea id="cxNote" rows="2" placeholder="Комментарий (по желанию)"></textarea>',
    ok: out ? "Изъять" : "Внести", danger: out,
    onOk: root => {
      const reason = root.querySelector("#cxReason").value, sum = num(root.querySelector("#cxSum").value), note = root.querySelector("#cxNote").value.trim();
      if (!reason) { dlgError("Выберите причину. Список меняется на листе настроек (ПРИЧИНЫ " + (out ? "ИЗЪЯТИЯ" : "ВНЕСЕНИЯ") + ")."); return false; }
      if (sum <= 0) { dlgError("Укажите сумму больше нуля."); return false; }
      if (out && S.db.cash && sum > S.db.cash.balance) { dlgError("В кассе только " + money(S.db.cash.balance) + "."); return false; }
      return () => enqueue({ label: op + " " + money(sum), fn: "cashOperation", args: [S.token, { op: op, sum: sum, reason: reason, note: note, requestId: uuid() }],
        ok: r => { toast(r.msg); applyData(r); } });
    } });
}

// ---------- сводная отчётность (считает сервер: «Заказы» + «Архив», все листы целиком) ----------
const REPORTS = [
  { id: "sales", title: "Продажи", hint: "выручка, средний чек, сравнение", period: true },
  { id: "staff", title: "Продажи сотрудников", hint: "выручка тому, кто создал заказ", period: true },
  { id: "money", title: "Деньги", hint: "кто принял оплаты, по способам", period: true, staff: true },
  { id: "cashio", title: "Внесения и изъятия", hint: "касса: размен, закупки", period: true, staff: true, reasons: true },
  { id: "goods", title: "Товары и маржа", hint: "что продаём и сколько зарабатываем", period: true },
  { id: "prices", title: "Закупочные цены", hint: "как менялась цена закупки", period: true, cost: true },
  { id: "debts", title: "Долги", hint: "кто ещё не доплатил", period: false },
  { id: "lost", title: "Отмены и отказы", hint: "причины, судьба товара, кто", period: true },
  { id: "bonus", title: "Бонусы", hint: "начислено, списано, у кого больше", period: true }
];
function renderTiles() {
  byId("repTiles").innerHTML = REPORTS.filter(r => !r.cost || can("cost")).map(r => '<div class="tile" onclick="openReport(\'' + r.id + '\')"><b>' + esc(r.title) + "</b><span>" + esc(r.hint) + "</span></div>").join("");
}
function isoOf(d) { return d.getFullYear() + "-" + ("0" + (d.getMonth() + 1)).slice(-2) + "-" + ("0" + d.getDate()).slice(-2); }
function openReport(id) {
  const r = REPORTS.find(x => x.id === id); if (!r) return;
  const t = ruToIso(S.db.cfg.today);
  S.rep = { id: id, from: t, to: t, user: "", reason: "" };
  byId("rvTitle").textContent = r.title;
  let f = "";
  if (r.period) {
    f += '<div class="chips"><div class="chip" onclick="repQuick(0)">Сегодня</div><div class="chip" onclick="repQuick(1)">Вчера</div>' +
      '<div class="chip" onclick="repQuick(7)">7 дней</div><div class="chip" onclick="repQuick(30)">30 дней</div>' +
      '<div class="chip" onclick="repQuick(\'month\')">Этот месяц</div><div class="chip" onclick="repQuick(\'prev\')">Прошлый месяц</div><div class="chip" onclick="repQuick(\'year\')">Год</div></div>' +
      '<div class="row"><div><label class="lbl">С</label><input type="date" id="rvFrom" value="' + t + '" onchange="repSet()"></div>' +
      '<div><label class="lbl">По</label><input type="date" id="rvTo" value="' + t + '" onchange="repSet()"></div></div>';
  }
  if (r.staff) f += '<select id="rvUser" onchange="repSet()"><option value="">Все сотрудники</option>' + (S.db.lists.users || []).map(n => '<option value="' + esc(n) + '">' + esc(n) + "</option>").join("") + "</select>";
  if (r.reasons) {
    const rs = (S.db.lists.cashIn || []).concat(S.db.lists.cashOut || []).filter((x, i, a) => a.indexOf(x) === i);
    f += '<select id="rvReason" onchange="repSet()"><option value="">Все причины</option>' + rs.map(n => '<option value="' + esc(n) + '">' + esc(n) + "</option>").join("") + "</select>";
  }
  byId("rvFilters").innerHTML = f;
  byId("rvBox").innerHTML = "";
  openModal("rvM");
  renderReport();
}
function repQuick(q) {
  const d = ruToDate(S.db.cfg.today);
  let from = new Date(d), to = new Date(d);
  if (q === 1) { from.setDate(from.getDate() - 1); to.setDate(to.getDate() - 1); }
  else if (q === 7 || q === 30) from.setDate(from.getDate() - (q - 1));
  else if (q === "month") from = new Date(d.getFullYear(), d.getMonth(), 1);
  else if (q === "prev") { from = new Date(d.getFullYear(), d.getMonth() - 1, 1); to = new Date(d.getFullYear(), d.getMonth(), 0); }
  else if (q === "year") { from = new Date(d); from.setFullYear(from.getFullYear() - 1); from.setDate(from.getDate() + 1); }
  byId("rvFrom").value = isoOf(from); byId("rvTo").value = isoOf(to);
  repSet();
}
function repSet() {
  if (byId("rvFrom")) { S.rep.from = byId("rvFrom").value; S.rep.to = byId("rvTo").value; }
  if (byId("rvUser")) S.rep.user = byId("rvUser").value;
  if (byId("rvReason")) S.rep.reason = byId("rvReason").value;
  renderReport();
}
function repVal(v, t) {
  if (t === "money") return money(v);
  if (t === "num") return fmt(v);
  if (t === "pct") return '<span style="color:' + (num(v) < 0 ? "var(--red)" : "var(--ok)") + ';">' + (num(v) > 0 ? "+" : "") + fmt(v) + "%</span>";
  return esc(v);
}
/** Запросить отчёт у сервера и показать. */
function renderReport() {
  if (!S.rep) return;
  if (S.rep.from && S.rep.to && S.rep.from > S.rep.to) { byId("rvBox").innerHTML = '<p class="err">Дата «С» позже даты «По».</p>'; return; }
  const opts = { from: S.rep.from, to: S.rep.to, user: S.rep.user, reason: S.rep.reason };
  call("getReport", [S.token, S.rep.id, opts], rep => {
    S.repData = rep;
    let h = '<p class="muted small">' + esc(rep.period) + "</p>";
    (rep.cards || []).forEach(c => { h += '<div class="card"><h3>' + esc(c.title) + "</h3>" + c.kv.map(x => kv(x[0], repVal(x[1], x[2]))).join("") + "</div>"; });
    (rep.tables || []).forEach(t => {
      h += '<div class="card"><h3>' + esc(t.title) + "</h3>" + (t.rows.length ? '<div style="overflow-x:auto;"><table class="tbl"><tr>' +
        t.cols.map(c => "<th" + (c.t !== "text" ? ' class="r"' : "") + ">" + esc(c.h) + "</th>").join("") + "</tr>" +
        t.rows.map(r => "<tr>" + r.map((v, i) => "<td" + (t.cols[i].t !== "text" ? ' class="r"' : "") + ">" + repVal(v, t.cols[i].t) + "</td>").join("") + "</tr>").join("") +
        "</table></div>" : '<p class="muted">Нет данных.</p>') + "</div>";
    });
    if (rep.note) h += '<p class="muted small">' + esc(rep.note) + "</p>";
    h += btnH("Выгрузить в Google Таблицу", "exportRep()", "btn-out");
    byId("rvBox").innerHTML = h;
  }, "Считаем отчёт…");
}
function exportRep() {
  if (!S.rep) return;
  const opts = { from: S.rep.from, to: S.rep.to, user: S.rep.user, reason: S.rep.reason };
  call("exportReport", [S.token, S.rep.id, opts], r => {
    dialog({ title: "Отчёт выгружен", html: '<p>Файл «' + esc(r.name) + '» сохранён в папку «SAYCRM_Отчёты» на Google Диске.</p><a class="ph" href="' + esc(r.url) + '" target="_blank" rel="noopener">Открыть таблицу</a>', ok: "Готово", cancel: false });
  }, "Выгружаем…");
}

/** Тихое обновление раз в минуту: без окна загрузки, только когда ничего не открыто и не сохраняется. */
setInterval(() => {
  if (!S.token || !S.user || S.busy || Q.jobs.length || document.hidden) return;
  if (document.querySelector(".modal.on") || byId("dlg").classList.contains("on")) return;
  srv("getInitialData", [S.token],
    d => { if (!Q.jobs.length && !document.querySelector(".modal.on")) { S.db = d; S.user = d.user; renderAll(); } },
    err => { const m = cleanErr(err && err.message ? err.message : err); if (m.indexOf("SESSION_EXPIRED") > -1) { showLogin(); showMsg(m.replace(/SESSION_EXPIRED:\s*/, "Сессия закончилась: "), true); } });
}, 60000);

autoLogin();
</script>
