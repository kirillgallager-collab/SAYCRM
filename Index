}
/** Тема: светлая или тёмная, запоминается на устройстве. */
let themeNow = "";
function theme() { return themeNow || lsGet("saycrm_theme") || "light"; }
function applyTheme() { document.documentElement.setAttribute("data-theme", theme() === "dark" ? "dark" : "light"); }
function toggleTheme() {   // если хранилище недоступно (бывает внутри Google), тема держится до перезагрузки
  themeNow = theme() === "dark" ? "light" : "dark";
